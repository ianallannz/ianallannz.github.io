{# _includes/navbar.njk #}
{% set latestPost = collections.pinnedPost %}
<nav>
    <a class="nav-brand" href="/">
        <span class="nav-brand-name">Ian Allan</span>
        <span class="nav-brand-role">Venture designer</span>
        <span class="nav-brand-role">Ethical technologist</span>
        <span class="nav-brand-role nav-brand-place">East Coast, New Zealand</span>
    </a>

    <div class="nav-left" onclick="location.href='{{ latestPost.url }}'" style="cursor:pointer;">
        <ul class="menu-left">

            <li class="latest-post">
                {% if page.url != '/blog/' %}
                    {% if page.url != latestPost.url %}
                <a class="scroll-text" href="{{ latestPost.url }}"><span class="latest-text" aria-hidden="true">★</span>{{ latestPost.data.title }}</a>
                    {% endif %}
                {% endif %}
            </li>
        </ul>
    </div>
    {% include "style-switch.njk" %}

    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
        ☰
    </button>


    {% include "navlinks.njk" %}
</nav>

{% if page.url == '/' %}
<a class="featured-strip" href="{{ latestPost.url }}">
    <span class="featured-strip-mark" aria-hidden="true">★</span>
    <span class="featured-strip-title">{{ latestPost.data.title }}</span>
    <span class="featured-strip-go" aria-hidden="true">→</span>
</a>
{% endif %}