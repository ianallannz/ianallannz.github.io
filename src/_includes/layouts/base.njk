<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon-256x256.png">
    <link id="style-og" rel="stylesheet" href="/css/custom.css">
    <link id="style-pro" rel="stylesheet" href="/css/pro.css">
    <script>
        // Apply the saved design before first paint. Default is custom.css.
        //
        // Both stylesheets are linked up front and the unwanted one is switched
        // off here. Swapping a single link's href instead disowns the current
        // stylesheet the moment it is set, leaving the document with NO styles
        // until the replacement downloads — which is what caused the flash of
        // raw markup (modals, diagonal rules) when moving between pages.
        // Parser-inserted stylesheets block rendering, and a script waits for
        // them, so by the time this runs both are loaded and first paint is
        // already correct. It also makes switching instant: no refetch.
        (function () {
            var pro = false;
            try { pro = localStorage.getItem('site-style') === 'pro'; } catch (e) { }
            document.documentElement.setAttribute('data-site-style', pro ? 'pro' : 'og');
            document.getElementById('style-og').disabled = pro;
            document.getElementById('style-pro').disabled = !pro;
        })();
    </script>
    <meta name="theme-color" content="#F4F4F4">
    <!-- SEO basics -->
    <meta name="description" content="{{ excerpt }}">
    <meta name="keywords" content="Ian Allan, ethical technologist, venture designer, product design, UX, UI, pitches, proposals, brand, market analysis, product-market fit, learning design">
    <meta name="author" content="Ian Allan">
    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ excerpt }}">
    <meta property="og:image" content="https://ianallannz.github.io/images/ianallan-social-share.jpg">
    <meta property="og:url" content="https://ianallannz.github.io{{ page.url }}">
    <meta property="og:type" content="website">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ excerpt }}">
    <meta name="twitter:image" content="https://ianallannz.github.io/images/ianallan-social-share.jpg">

</head>

<body class="{{ page.fileSlug }}">
    {% include "lines.njk" %}

    {{ content | safe }}

    {% include "modal-contact.njk" %}
    {% include "footer.njk" %}

    <script src="/js/custom.js" defer></script>
</body>

</html>