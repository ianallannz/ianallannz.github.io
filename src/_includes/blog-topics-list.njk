{# _includes/blog-topics-list.njk #}
{# The label sits in its own span so custom.js can swap it without destroying
   the bracket spans either side — pro.css hides those, the OG design keeps
   them. #}
<h2 class="toggle-topics"><a href="#" class="toggle-link"><span class="bracket">[</span><span
            class="toggle-label">Show topics⇣</span><span class="bracket">]</span></a></h2>
<ul class="topics-list">
    {% for tag in collections.tagList %}
    <li>
        <a href="/blog/topics/{{ tag | slug }}/">
            {{ tag }} ({{ collections[tag] | length }})
        </a>
    </li>
    {% endfor %}
</ul>